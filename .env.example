# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Next.js Web (same values, different prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Cloudinary (image uploads — free plan)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=junglapp_uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=junglapp_uploads

# Firebase Local Emulator Suite — OPT-IN ONLY. Leave unset/false for every
# normal build, including the ones you archive for the App Store — a real
# device can never reach "localhost" on your Mac, so shipping a build with
# this set to true would break the app for every user.
# Turn it on ONLY in your own .env.local while running `npm run emulators`
# (repo root) in another terminal, to test Cloud Functions/Firestore rules
# changes against fake local data before touching the real project. Turn it
# back off (or delete the line) before your next real build.
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
# ^ localhost works for the iOS Simulator and web. An Android emulator needs
# 10.0.2.2 instead; a physical device needs your Mac's LAN IP (e.g. 192.168.x.x).
