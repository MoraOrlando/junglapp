{
  "expo": {
    "name": "JunglApp",
    "slug": "junglapp",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D6A4F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.junglapp.app",
      "buildNumber": "2",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "junglapp"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "JunglApp usa la red local para conectarse al servidor de desarrollo durante las pruebas.",
        "NSBonjourServices": ["_dev._tcp", "_http._tcp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6A4F"
      },
      "package": "com.junglapp.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 6,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAZa8-UtT_g8jw8E92rLb27tre-9mGnlSs"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBStorage"]
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "JunglApp usa Face ID para que ingreses de forma rápida y segura."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JunglApp necesita acceso a tus fotos para subir imágenes de tus mascotas.",
          "cameraPermission": "JunglApp necesita acceso a tu cámara para tomar fotos de tus mascotas."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "JunglApp necesita acceso a tu calendario para agregar recordatorios de visitas veterinarias."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JunglApp usa tu ubicación para mostrarte veterinarios, tiendas y mascotas extraviadas cercanas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#2D6A4F",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "JunglApp"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "junglapp",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f180251b-69ce-4b38-a310-b8de516042fa"
      }
    },
    "owner": "vetapp"
  }
}
