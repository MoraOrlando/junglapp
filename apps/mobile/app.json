{
  "expo": {
    "name": "JunglApp",
    "slug": "junglapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D6A4F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.junglapp.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6A4F"
      },
      "package": "com.junglapp.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "JunglApp needs access to your photos to upload pet pictures.",
          "cameraPermission": "JunglApp needs access to your camera to take pet photos."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "JunglApp necesita acceso a tu calendario para agregar recordatorios de visitas veterinarias."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JunglApp usa tu ubicación para mostrarte veterinarios, tiendas y mascotas extraviadas cercanas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "junglapp"
  }
}
