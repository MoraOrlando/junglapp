{
  "expo": {
    "name": "JunglApp",
    "slug": "junglapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D6A4F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.junglapp.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.499650328037-j4edei7e54rpebd04ebpdv1iooilj10a"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6A4F"
      },
      "package": "com.junglapp.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "JunglApp usa Face ID para que ingreses de forma rápida y segura."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JunglApp necesita acceso a tus fotos para subir imágenes de tus mascotas.",
          "cameraPermission": "JunglApp necesita acceso a tu cámara para tomar fotos de tus mascotas."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "JunglApp necesita acceso a tu calendario para agregar recordatorios de visitas veterinarias."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JunglApp usa tu ubicación para mostrarte veterinarios, tiendas y mascotas extraviadas cercanas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "junglapp"
  }
}
