{
  "rules": {
    "chatMembers": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
        ".write": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
        "$msgId": {
          ".validate": "newData.hasChildren(['senderId', 'senderName', 'text', 'createdAt']) && newData.child('senderId').val() === auth.uid && newData.child('text').val().length > 0 && newData.child('text').val().length <= 2000"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && $uid === auth.uid"
      }
    }
  }
}
