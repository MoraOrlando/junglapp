rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSupport() {
      return isAuth() && getRole() == 'support';
    }

    // Incoming data does not change a field
    function fieldUnchanged(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // Only the owner reads own doc; support reads all.
    // Users cannot self-assign the 'support' role.
    match /users/{uid} {
      allow read: if isSelf(uid) || isSupport();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['owner', 'vet', 'store'];
      allow update: if (isSelf(uid) && fieldUnchanged('role'))
        || isSupport();
      allow delete: if isSupport();
    }

    // ── Pets ───────────────────────────────────────────────────────────────
    // Owners see their own pets + any pet with lookingForPartner=true.
    // Vets/support can read all (needed for appointment context).
    match /pets/{petId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.lookingForPartner == true ||
        getRole() in ['vet', 'support']
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Veterinarians ──────────────────────────────────────────────────────
    // All authenticated users can read (needed for booking).
    // Self can update profile fields; only support can change status.
    match /veterinarians/{vetId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && fieldUnchanged('status'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Stores ─────────────────────────────────────────────────────────────
    // All authenticated users can read (needed for browsing).
    // Self can update store info; only support can change status.
    match /stores/{storeId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && fieldUnchanged('status'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Products ───────────────────────────────────────────────────────────
    // Public read (storefronts are visible to all users).
    // Write restricted to the store owner.
    match /products/{productId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.userId == request.auth.uid;
      allow update, delete: if isAuth() && (
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid
        || isSupport()
      );
    }

    // ── Appointments ───────────────────────────────────────────────────────
    // Only the owner and the assigned vet can read/update.
    // Only owners can create (booking) or delete (cancellation).
    match /appointments/{apptId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.vetId == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.vetId == request.auth.uid ||
        isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Matches ────────────────────────────────────────────────────────────
    // Only the two involved owners can read/update.
    // Creator must be owner1.
    // Matches cannot be deleted (permanent history).
    match /matches/{matchId} {
      allow read: if isAuth() && (
        resource.data.owner1Id == request.auth.uid ||
        resource.data.owner2Id == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.owner1Id == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.owner1Id == request.auth.uid ||
        resource.data.owner2Id == request.auth.uid
      );
      allow delete: if false;
    }

    // ── Chats ──────────────────────────────────────────────────────────────
    // Only chat participants can read or update.
    // Creator must include themselves in the participants array.
    match /chats/{chatId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.participants || isSupport()
      );
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAuth() && (
        request.auth.uid in resource.data.participants || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Lost pets ──────────────────────────────────────────────────────────
    // Publicly readable (community feature).
    // Only the reporting owner or support can update/delete.
    match /lostPets/{lostPetId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    // Buyer and store owner can read; only buyer can create; only store can update status.
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuth() && (
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid
        || isSupport()
      );
      allow delete: if isSupport();
    }
  }
}
