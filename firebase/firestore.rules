rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Safe role lookup — returns 'guest' if the user doc is missing or has no role,
    // preventing exception-based bypass.
    function getRole() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return doc != null && doc.data != null && 'role' in doc.data ? doc.data.role : 'guest';
    }

    function isSupport() {
      return isAuth() && getRole() == 'support';
    }

    function fieldUnchanged(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    // A professional (vet/walker/grooming/trainer) may only read an owner's
    // profile if that owner has actually booked with them (see clientLinks,
    // written client-side at booking time). Without this, any approved
    // professional could read every owner's PII just by knowing their uid.
    function isLinkedClient(ownerId) {
      return exists(/databases/$(database)/documents/clientLinks/$(request.auth.uid + '_' + ownerId));
    }

    // A collaborator account (added by the store owner from the web portal)
    // gets the same operational access as the owner without being the
    // stores/{storeId} doc's own userId — membership lives in staffUids,
    // written server-side (Cloud Function, Admin SDK) on invite and
    // removable by the owner via a normal client update (already allowed by
    // the stores update rule below, since it only locks the `status` field).
    function isStoreStaff(storeId) {
      return isAuth() && request.auth.uid in get(/databases/$(database)/documents/stores/$(storeId)).data.get('staffUids', []);
    }

    // Lets a store owner read a collaborator's profile (to list their
    // name/email/phone in the portal) — the store doc's ID is the owner's
    // own uid (stores/{storeId} === stores/{ownerUid}), so this only needs
    // to check the caller's own store's staffUids, not an arbitrary one.
    function isMyStoreStaffMember(uid) {
      return isAuth() && uid in get(/databases/$(database)/documents/stores/$(request.auth.uid)).data.get('staffUids', []);
    }

    // Same pattern as isStoreStaff/isMyStoreStaffMember above, for a
    // veterinary clinic's collaborator vets (see createVetCollaborator).
    function isVetStaff(vetId) {
      return isAuth() && request.auth.uid in get(/databases/$(database)/documents/veterinarians/$(vetId)).data.get('staffUids', []);
    }
    function isMyVetStaffMember(uid) {
      return isAuth() && uid in get(/databases/$(database)/documents/veterinarians/$(request.auth.uid)).data.get('staffUids', []);
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSelf(uid) || isSupport()
        || (isAuth() && getRole() in ['vet', 'walker', 'grooming', 'trainer'] && isLinkedClient(uid))
        || isMyStoreStaffMember(uid)
        || isMyVetStaffMember(uid);
      allow create: if (isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role in ['owner', 'vet', 'store', 'trainer', 'walker', 'grooming'])
        || (isSupport()
          && request.resource.data.uid == uid
          && request.resource.data.role == 'support');
      allow update: if (isSelf(uid) && fieldUnchanged('role') && fieldUnchanged('uid') && fieldUnchanged('accountStatus'))
        || isSupport();
      // Hard-deny role escalation even for support via update
      allow delete: if false;
    }

    // ── Pets ───────────────────────────────────────────────────────────────
    match /pets/{petId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.lookingForPartner == true ||
        getRole() in ['vet', 'support']
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Veterinarians ──────────────────────────────────────────────────────
    match /veterinarians/{vetId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        // A clinic's collaborator vets (isVetStaff) can only touch the
        // shared agenda fields — never identity fields, status, or
        // staffUids itself (that's only ever written by
        // createVetCollaborator via the Admin SDK, or removed by the owner
        // through the unrestricted owner branch above).
        || (isVetStaff(vetId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'slotDuration', 'consultationFee']))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Trainers ───────────────────────────────────────────────────────────
    match /trainers/{trainerId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Walkers ────────────────────────────────────────────────────────────
    match /walkers/{walkerId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Groomers ───────────────────────────────────────────────────────────
    match /groomers/{groomerId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Reviews ────────────────────────────────────────────────────────────
    // One review per user per target — enforced by using ownerId+targetId as document ID
    // at write time from the client.
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;
      // Only the author can update/delete their own review
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── Places (community-added parks/restaurants in "Entretención") ────────
    match /places/{placeId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category in ['park', 'restaurant']
        && request.resource.data.location is map
        && request.resource.data.rating == 0
        && request.resource.data.reviewCount == 0;
      allow update: if isAuth() && (
        (resource.data.createdBy == request.auth.uid
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport() || resource.data.createdBy == request.auth.uid;
    }

    match /placeReviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── Events (community events in "Entretención", e.g. a dog run) ────────
    match /events/{eventId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.eventDate is string
        && request.resource.data.expiresAt is string;
      allow update: if isAuth() && (
        (resource.data.createdBy == request.auth.uid && fieldUnchanged('createdBy'))
        || isSupport()
      );
      allow delete: if isSupport() || resource.data.createdBy == request.auth.uid;
    }

    // ── Medical Visits ─────────────────────────────────────────────────────
    match /medicalVisits/{visitId} {
      // Vets need full read access to patient history for any pet in their care.
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        getRole() == 'vet' ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Reminders (próximos controles veterinarios) ────────────────────────
    // Read also allowed for role vet/support — same broad precedent as
    // pets/medicalVisits above (getRole() doesn't depend on resource.data,
    // so it's provable for list queries too) — needed for the vet web
    // portal's Recordatorios module (see apps/web/app/vet/page.tsx) to show
    // a clinic's patients' due reminders. Creation/updates stay owner-only —
    // the vet portal only reads this collection, never writes it.
    match /reminders/{reminderId} {
      allow read: if isAuth() && (resource.data.ownerId == request.auth.uid || getRole() in ['vet', 'support']);
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── Vet invites (invitaciones a veterinarios no registrados) ──────────
    match /vetInvites/{inviteId} {
      allow read: if isSupport();
      allow create: if isAuth()
        && request.resource.data.invitedBy == request.auth.uid
        // Limit invite fields to prevent spam payloads
        && request.resource.data.keys().hasOnly(['vetName', 'vetEmail', 'invitedBy', 'invitedByName', 'status', 'createdAt']);
      allow update, delete: if isSupport();
    }

    // ── Stores ─────────────────────────────────────────────────────────────
    match /stores/{storeId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && fieldUnchanged('status'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Products ───────────────────────────────────────────────────────────
    // A store may only request a promotion slot (promotionStatus: 'pending')
    // if it's on the Premium plan — see subscriptions/{storeId} below.
    function isPremiumStore(storeId) {
      return exists(/databases/$(database)/documents/subscriptions/$(storeId)) &&
        get(/databases/$(database)/documents/subscriptions/$(storeId)).data.plan == 'premium';
    }

    match /products/{productId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid
        || isStoreStaff(request.resource.data.storeId)
        || isSupport()
      );
      // The owning store can change anything except it may never set
      // promotionStatus to 'approved' itself — only support can approve (or
      // later revoke by setting it back to 'rejected') a promo banner slot —
      // and it may only request 'pending' if it's Premium.
      allow update: if isAuth() && (
        ((resource.data.userId == request.auth.uid || isStoreStaff(resource.data.storeId))
          && request.resource.data.get('promotionStatus', null) != 'approved'
          && (request.resource.data.get('promotionStatus', null) != 'pending' || isPremiumStore(resource.data.storeId)))
        || isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid
        || isStoreStaff(resource.data.storeId)
        || isSupport()
      );
    }

    // ── Appointments ───────────────────────────────────────────────────────
    // vetId is the Firestore document ID of the provider profile (vet, trainer or walker),
    // not the auth UID. We resolve ownership via get() on the matching provider collection.
    function isVetOfAppointment(vetDocId) {
      return vetDocId != null &&
        (get(/databases/$(database)/documents/veterinarians/$(vetDocId)).data.userId == request.auth.uid
          || isVetStaff(vetDocId));
    }
    function isTrainerOfAppointment(providerDocId) {
      return providerDocId != null &&
        exists(/databases/$(database)/documents/trainers/$(providerDocId)) &&
        get(/databases/$(database)/documents/trainers/$(providerDocId)).data.userId == request.auth.uid;
    }
    function isWalkerOfAppointment(providerDocId) {
      return providerDocId != null &&
        exists(/databases/$(database)/documents/walkers/$(providerDocId)) &&
        get(/databases/$(database)/documents/walkers/$(providerDocId)).data.userId == request.auth.uid;
    }
    function isGroomerOfAppointment(providerDocId) {
      return providerDocId != null &&
        exists(/databases/$(database)/documents/groomers/$(providerDocId)) &&
        get(/databases/$(database)/documents/groomers/$(providerDocId)).data.userId == request.auth.uid;
    }

    match /appointments/{apptId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isVetOfAppointment(resource.data.vetId) ||
        isTrainerOfAppointment(resource.data.vetId) ||
        isWalkerOfAppointment(resource.data.vetId) ||
        isGroomerOfAppointment(resource.data.vetId) ||
        isSupport()
      );
      // Creation moved server-side to the createAppointment Cloud Function —
      // it needs to atomically enforce the Premium plan's weekly quota
      // (subscriptions/{vetId}), which a client-side rule can't do.
      allow create: if false;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isVetOfAppointment(resource.data.vetId) ||
        isTrainerOfAppointment(resource.data.vetId) ||
        isWalkerOfAppointment(resource.data.vetId) ||
        isGroomerOfAppointment(resource.data.vetId) ||
        isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Walk plan purchases ─────────────────────────────────────────────────
    // A pet owner's purchase of a walker's fixed-quantity walk package (see
    // Walker.planEnabled). Created directly by the client (no real payment
    // happens — this just records the purchase, same as every other price
    // in the app). walksRemaining is only ever decremented by the
    // onAppointmentUpdated Cloud Function, never by a client write.
    match /walkPlanPurchases/{purchaseId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isWalkerOfAppointment(resource.data.walkerId) ||
        isSupport()
      );
      allow create: if isSelf(request.resource.data.ownerId)
        && request.resource.data.walksIncluded is int && request.resource.data.walksIncluded > 0
        && request.resource.data.walksRemaining == request.resource.data.walksIncluded
        && request.resource.data.status == 'active';
      // The owner may only cancel their own still-active plan — walksRemaining/
      // walksIncluded/ownerId/walkerId/price are otherwise immutable from the
      // client (walksRemaining changes only via the Cloud Function above,
      // which uses the Admin SDK and bypasses these rules entirely).
      allow update: if isSelf(resource.data.ownerId)
        && resource.data.status == 'active'
        && request.resource.data.status == 'cancelled'
        && fieldUnchanged('walksRemaining') && fieldUnchanged('walksIncluded')
        && fieldUnchanged('ownerId') && fieldUnchanged('walkerId') && fieldUnchanged('price');
      allow delete: if false;
    }

    // ── Trainer Appointments ───────────────────────────────────────────────
    match /trainerAppointments/{apptId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Matches ────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isAuth() && (
        resource.data.owner1Id == request.auth.uid ||
        resource.data.owner2Id == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.owner1Id == request.auth.uid;
      // Either owner can only update the status field (e.g. to unmatch)
      allow update: if isAuth() && (
        resource.data.owner1Id == request.auth.uid ||
        resource.data.owner2Id == request.auth.uid
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // ── Chats ──────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.participants || isSupport()
      );
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAuth() && (
        request.auth.uid in resource.data.participants || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Lost pets ──────────────────────────────────────────────────────────
    match /lostPets/{lostPetId} {
      // Community feature: all auth users can browse lost pets to help find them.
      // Contact PII is justified by the humanitarian purpose of the feature.
      allow read: if isAuth();
      // Reporter must own the pet they are reporting
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid ||
        isStoreStaff(resource.data.storeId) ||
        isSupport()
      );
      // Creation moved server-side to the createOrder Cloud Function — same
      // reason as appointments above (atomic Premium weekly-quota check).
      allow create: if false;
      // Store owner (or staff) can only update status + updatedAt. The buyer
      // may only cancel their own order (while it's still pending or while
      // an alternative is being negotiated) or accept an offered alternative
      // — never touch products/total/shippingAddress once the store has
      // acted on it. While still pending (store hasn't confirmed yet), the
      // buyer may instead edit products/total to add/remove items.
      allow update: if isAuth() && (
        ((get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid || isStoreStaff(resource.data.storeId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || (resource.data.buyerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledBy'])
          && (
            (resource.data.status == 'pending' && request.resource.data.status == 'cancelled') ||
            (resource.data.status == 'alternative_offered' && request.resource.data.status in ['cancelled', 'confirmed'])
          ))
        || (resource.data.buyerId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['products', 'total', 'updatedAt']))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // In-store (physical) POS sales, recorded from the web store portal.
    // Deliberately separate from /orders (no buyer, no shipping, no status
    // flow) — immutable once created, only the owning store can read/create.
    match /posSales/{saleId} {
      // buyerId is only ever set server-side by the linkPosSaleToBuyer Cloud
      // Function (Admin SDK, bypasses this rule) when a storeCustomer's email
      // matches a registered owner account — this just lets that owner read
      // their own linked in-store purchases (apps/mobile historial.tsx).
      allow read: if isAuth() && (
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid
        || isStoreStaff(resource.data.storeId)
        || isSupport()
        || resource.data.buyerId == request.auth.uid
      );
      allow create: if isAuth()
        && (get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.userId == request.auth.uid
          || isStoreStaff(request.resource.data.storeId));
      allow update, delete: if isSupport();
    }

    // ── Store Customers (POS checkout — name/RUT/email on file) ────────────
    // Foundation for a future loyalty program; also what lets a sale be
    // linked to a registered owner account (see posSales.buyerId above) and
    // the receipt emailed. Store-scoped, same owner/staff pattern as posSales.
    match /storeCustomers/{customerId} {
      allow read, update: if isAuth() && (
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid
        || isStoreStaff(resource.data.storeId)
      );
      allow create: if isAuth()
        && (get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.userId == request.auth.uid
          || isStoreStaff(request.resource.data.storeId));
      allow delete: if isSupport();
    }

    // ── Vet Services (clinic price list for the Fase 3 ERP billing flow) ───
    // Same owner/staff pattern as products — publicly readable (isAuth())
    // since these will eventually surface in a booking/browsing flow too.
    function isVetOwnerOrStaff(vetId) {
      return isAuth() && (
        get(/databases/$(database)/documents/veterinarians/$(vetId)).data.userId == request.auth.uid
        || isVetStaff(vetId)
      );
    }
    match /vetServices/{serviceId} {
      allow read: if isAuth();
      allow create: if isVetOwnerOrStaff(request.resource.data.vetId);
      allow update, delete: if isVetOwnerOrStaff(resource.data.vetId) || isSupport();
    }

    // ── Exam Orders (Fase 3: solicitar examen + subir resultado) ───────────
    // Clinical record, not billing — see vetSales below for charges.
    // Read is owner-of-the-pet OR the requesting clinic OR support; only the
    // clinic (owner/staff) can create/update (mark ready, attach resultUrl).
    match /examOrders/{orderId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid
        || isVetOwnerOrStaff(resource.data.vetId)
        || isSupport()
      );
      allow create: if isVetOwnerOrStaff(request.resource.data.vetId);
      allow update: if isVetOwnerOrStaff(resource.data.vetId) || isSupport();
      allow delete: if isSupport();
    }

    // ── Vet Sales (Fase 3: cobro de servicios/exámenes por atención) ───────
    // Same immutable-once-created pattern as posSales — a charge record
    // shouldn't be editable after the fact; only support can fix mistakes.
    match /vetSales/{saleId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid
        || isVetOwnerOrStaff(resource.data.vetId)
        || isSupport()
      );
      allow create: if isVetOwnerOrStaff(request.resource.data.vetId);
      allow update, delete: if isSupport();
    }

    // ── Vet Expenses (Finanzas module: manual bookkeeping entries) ─────────
    // Internal ledger, not a billing receipt — unlike vetSales, owner/staff
    // may edit or delete their own entries (e.g. to fix a typo'd amount).
    match /vetExpenses/{expenseId} {
      allow read: if isVetOwnerOrStaff(resource.data.vetId) || isSupport();
      allow create: if isVetOwnerOrStaff(request.resource.data.vetId);
      allow update, delete: if isVetOwnerOrStaff(resource.data.vetId) || isSupport();
    }

    // ── Vet Inventory (Inventario module: catalog + stock movements) ───────
    // Same owner/staff pattern as vetServices/vetExpenses — staff needs
    // write access too since they're the ones checking/using stock day to
    // day, not just the clinic owner.
    match /vetInventoryItems/{itemId} {
      allow read: if isVetOwnerOrStaff(resource.data.vetId) || isSupport();
      allow create: if isVetOwnerOrStaff(request.resource.data.vetId);
      allow update, delete: if isVetOwnerOrStaff(resource.data.vetId) || isSupport();
    }
    match /vetInventoryMovements/{movementId} {
      allow read: if isVetOwnerOrStaff(resource.data.vetId) || isSupport();
      allow create: if isVetOwnerOrStaff(request.resource.data.vetId);
      // Movements are an append-only log (mirrors vetSales) — a mistaken
      // entry gets corrected with an opposite adjustment, not edited away.
      allow update, delete: if isSupport();
    }

    // ── Vet Reminder Sends (Recordatorios/WhatsApp module — click log) ─────
    // Append-only, same reasoning as vetInventoryMovements: it's a log of
    // "Enviar" clicks, not something staff should be able to rewrite.
    match /vetReminderSends/{sendId} {
      allow read: if isVetOwnerOrStaff(resource.data.vetId) || isSupport();
      allow create: if isVetOwnerOrStaff(request.resource.data.vetId);
      allow update, delete: if isSupport();
    }

    // ── Litters (camadas disponibles) ──────────────────────────────────────
    match /litters/{litterId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (resource.data.ownerId == request.auth.uid || isSupport());
      allow delete: if isAuth() && (resource.data.ownerId == request.auth.uid || isSupport());
    }

    // ── Content Reports (user-generated content moderation) ────────────────
    match /reports/{reportId} {
      allow read: if isSupport();
      allow create: if isAuth()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && (request.resource.data.chatId is string || request.resource.data.placeId is string || request.resource.data.eventId is string)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 2000
        && (!('reportedUserName' in request.resource.data) || (request.resource.data.reportedUserName is string && request.resource.data.reportedUserName.size() <= 200))
        && request.resource.data.status == 'pending';
      allow update: if isSupport();
      allow delete: if false;
    }

    // ── User Blocks ──────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if isAuth() && resource.data.blockerId == request.auth.uid;
      allow create: if isAuth()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid;
      allow delete: if isAuth() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // ── Client Links (professional ↔ owner booking relationships) ──────────
    // Written client-side when an owner books an appointment. Used only to
    // scope `users/{uid}` read access — see isLinkedClient() above.
    match /clientLinks/{linkId} {
      allow read: if isAuth() && resource.data.professionalId == request.auth.uid;
      // create and update share the same check: the link is a plain
      // existence marker re-written (with merge) on every booking, so a
      // second booking with the same professional must not be rejected
      // just because the doc already exists from the first one.
      allow create, update: if isAuth()
        && request.resource.data.ownerId is string
        && request.resource.data.professionalId is string
        && (request.auth.uid == request.resource.data.ownerId || request.auth.uid == request.resource.data.professionalId)
        && linkId == request.resource.data.professionalId + '_' + request.resource.data.ownerId;
      allow delete: if false;
    }

    // ── Subscriptions (Premium plan) ────────────────────────────────────────
    // Doc ID matches the profile's own doc ID, which is the owner's auth uid
    // for all 5 professional types (stores/vets/trainers/walkers/groomers all
    // setDoc(..., ownerUid) at registration). Readable by any authenticated
    // user (not just isSelf/support) — plan tier ranks "Cerca de ti" search
    // results, so every owner's client needs to read it, same as
    // products/stores/veterinarians are all isAuth()-readable.
    // weekCount/weekStart are only ever written by checkAndConsumeQuota
    // (Cloud Function, Admin SDK, bypasses these rules) — plan is only ever
    // written by support here, never by the professional itself (that would
    // let a store grant itself Premium for free).
    match /subscriptions/{profileId} {
      allow read: if isAuth();
      allow create, update: if isSupport();
      allow delete: if false;
    }

    // ── Password Reset Cooldowns (server-side only) ────────────────────────
    match /_passwordResetCooldowns/{email} {
      allow read, write: if false;
    }
  }
}
