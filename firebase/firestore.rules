rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Safe role lookup — returns 'guest' if the user doc is missing or has no role,
    // preventing exception-based bypass.
    function getRole() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return doc != null && doc.data != null && 'role' in doc.data ? doc.data.role : 'guest';
    }

    function isSupport() {
      return isAuth() && getRole() == 'support';
    }

    function fieldUnchanged(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSelf(uid) || isSupport();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['owner', 'vet', 'store', 'trainer'];
      allow update: if (isSelf(uid) && fieldUnchanged('role') && fieldUnchanged('uid'))
        || isSupport();
      // Hard-deny role escalation even for support via update
      allow delete: if false;
    }

    // ── Pets ───────────────────────────────────────────────────────────────
    match /pets/{petId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.lookingForPartner == true ||
        getRole() in ['vet', 'support']
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Veterinarians ──────────────────────────────────────────────────────
    match /veterinarians/{vetId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Trainers ───────────────────────────────────────────────────────────
    match /trainers/{trainerId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Walkers ────────────────────────────────────────────────────────────
    match /walkers/{walkerId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Groomers ───────────────────────────────────────────────────────────
    match /groomers/{groomerId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Reviews ────────────────────────────────────────────────────────────
    // One review per user per target — enforced by using ownerId+targetId as document ID
    // at write time from the client.
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;
      // Only the author can update/delete their own review
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── Medical Visits ─────────────────────────────────────────────────────
    match /medicalVisits/{visitId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.vetId == request.auth.uid ||
        isSupport()
      );
      // Only the pet owner can create manual visit records
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.vetId == request.auth.uid ||
        isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Reminders (próximos controles veterinarios) ────────────────────────
    match /reminders/{reminderId} {
      allow read: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── Vet invites (invitaciones a veterinarios no registrados) ──────────
    match /vetInvites/{inviteId} {
      allow read: if isSupport();
      allow create: if isAuth()
        && request.resource.data.invitedBy == request.auth.uid
        // Limit invite fields to prevent spam payloads
        && request.resource.data.keys().hasOnly(['vetName', 'vetEmail', 'invitedBy', 'invitedByName', 'status', 'createdAt']);
      allow update, delete: if isSupport();
    }

    // ── Stores ─────────────────────────────────────────────────────────────
    match /stores/{storeId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && fieldUnchanged('status'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Products ───────────────────────────────────────────────────────────
    // Create: verify the user owns the store referenced by storeId
    match /products/{productId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.userId == request.auth.uid;
      allow update, delete: if isAuth() && (
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid
        || isSupport()
      );
    }

    // ── Appointments ───────────────────────────────────────────────────────
    match /appointments/{apptId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.vetId == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      // Owner or the assigned vet can update; only allowed vet fields for vets
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.vetId == request.auth.uid ||
        isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Trainer Appointments ───────────────────────────────────────────────
    match /trainerAppointments/{apptId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Matches ────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isAuth() && (
        resource.data.owner1Id == request.auth.uid ||
        resource.data.owner2Id == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.owner1Id == request.auth.uid;
      // Either owner can only update the status field (e.g. to unmatch)
      allow update: if isAuth() && (
        resource.data.owner1Id == request.auth.uid ||
        resource.data.owner2Id == request.auth.uid
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // ── Chats ──────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.participants || isSupport()
      );
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAuth() && (
        request.auth.uid in resource.data.participants || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Lost pets ──────────────────────────────────────────────────────────
    match /lostPets/{lostPetId} {
      // Community feature: all auth users can browse lost pets to help find them.
      // Contact PII is justified by the humanitarian purpose of the feature.
      allow read: if isAuth();
      // Reporter must own the pet they are reporting
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.buyerId == request.auth.uid;
      // Store owner can only update status + updatedAt
      allow update: if isAuth() && (
        (get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Password Reset Cooldowns (server-side only) ────────────────────────
    match /_passwordResetCooldowns/{email} {
      allow read, write: if false;
    }
  }
}
