rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSupport() {
      return isAuth() && getRole() == 'support';
    }

    function fieldUnchanged(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSelf(uid) || isSupport();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['owner', 'vet', 'store', 'trainer'];
      allow update: if (isSelf(uid) && fieldUnchanged('role') && fieldUnchanged('uid'))
        || isSupport();
      allow delete: if isSupport();
    }

    // ── Pets ───────────────────────────────────────────────────────────────
    match /pets/{petId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.lookingForPartner == true ||
        getRole() in ['vet', 'support']
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Veterinarians ──────────────────────────────────────────────────────
    match /veterinarians/{vetId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Trainers ───────────────────────────────────────────────────────────
    match /trainers/{trainerId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Walkers ────────────────────────────────────────────────────────────
    match /walkers/{walkerId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Groomers ───────────────────────────────────────────────────────────
    match /groomers/{groomerId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldUnchanged('status')
          && fieldUnchanged('rating')
          && fieldUnchanged('reviewCount'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Reviews ────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── Medical Visits ─────────────────────────────────────────────────────
    match /medicalVisits/{visitId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.vetId == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.vetId == request.auth.uid ||
        isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Reminders (próximos controles veterinarios) ────────────────────────
    match /reminders/{reminderId} {
      allow read: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── Vet invites (invitaciones a veterinarios no registrados) ──────────
    match /vetInvites/{inviteId} {
      allow read: if isSupport();
      allow create: if isAuth() && request.resource.data.invitedBy == request.auth.uid;
      allow update, delete: if isSupport();
    }

    // ── Stores ─────────────────────────────────────────────────────────────
    match /stores/{storeId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && fieldUnchanged('status'))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Products ───────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.userId == request.auth.uid;
      allow update, delete: if isAuth() && (
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid
        || isSupport()
      );
    }

    // ── Appointments ───────────────────────────────────────────────────────
    match /appointments/{apptId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.vetId == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.vetId == request.auth.uid ||
        isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Trainer Appointments ───────────────────────────────────────────────
    match /trainerAppointments/{apptId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Matches ────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isAuth() && (
        resource.data.owner1Id == request.auth.uid ||
        resource.data.owner2Id == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.owner1Id == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.owner1Id == request.auth.uid ||
        resource.data.owner2Id == request.auth.uid
      );
      allow delete: if false;
    }

    // ── Chats ──────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.participants || isSupport()
      );
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAuth() && (
        request.auth.uid in resource.data.participants || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Lost pets ──────────────────────────────────────────────────────────
    match /lostPets/{lostPetId} {
      // Contains contact PII (phone/email) — auth required to read
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || isSupport()
      );
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid ||
        isSupport()
      );
      allow create: if isAuth()
        && request.resource.data.buyerId == request.auth.uid;
      // Store owner can only update status field
      allow update: if isAuth() && (
        (get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || isSupport()
      );
      allow delete: if isSupport();
    }

    // ── Password Reset Cooldowns (internal) ────────────────────────────────
    match /_passwordResetCooldowns/{email} {
      allow read, write: if false; // server-side only
    }
  }
}
