rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf';
    }

    function maxSize(mb) {
      return request.resource.size <= mb * 1024 * 1024;
    }

    // ── User profile photos ────────────────────────────────────────────────
    // Only the user can write their own profile photo.
    match /users/{uid}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.auth.uid == uid
        && isImageOrPdf()
        && maxSize(5);
    }

    // ── Pet photos ─────────────────────────────────────────────────────────
    // Path: pets/{ownerId}/{petId}/{fileName}
    // Only the pet owner (matched by ownerId path segment) can upload.
    match /pets/{ownerId}/{petId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.auth.uid == ownerId
        && isImageOrPdf()
        && maxSize(10);
    }

    // ── Vet credentials and profile photos ────────────────────────────────
    // Path: vets/{vetUserId}/{fileName}
    // Only the vet (matched by vetUserId path segment) can upload.
    match /vets/{vetUserId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.auth.uid == vetUserId
        && isImageOrPdf()
        && maxSize(10);
    }

    // ── Store logos ────────────────────────────────────────────────────────
    // Path: stores/{storeUserId}/{fileName}
    // Only the store owner (matched by storeUserId path segment) can upload.
    match /stores/{storeUserId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.auth.uid == storeUserId
        && isImageOrPdf()
        && maxSize(10);
    }

    // ── Product photos ─────────────────────────────────────────────────────
    // Path: products/{storeUserId}/{productId}/{fileName}
    // Only the store owner (matched by storeUserId) can upload product photos.
    match /products/{storeUserId}/{productId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.auth.uid == storeUserId
        && isImageOrPdf()
        && maxSize(10);
    }

    // ── Prescription images ────────────────────────────────────────────────
    // Path: prescriptions/{vetUserId}/{ownerUserId}/{apptId}/{fileName}
    // Only the vet (upload) or the appointment owner (read) can access.
    match /prescriptions/{vetUserId}/{ownerUserId}/{apptId}/{fileName} {
      allow read: if isAuth() && (
        request.auth.uid == vetUserId || request.auth.uid == ownerUserId
      );
      allow write: if isAuth()
        && request.auth.uid == vetUserId
        && isImageOrPdf()
        && maxSize(10);
    }

    // ── Lost pet photos ────────────────────────────────────────────────────
    // Path: lostPets/{ownerUid}/{lostPetId}/{fileName}
    // Auth-gated read; only the owner can upload.
    match /lostPets/{ownerUid}/{lostPetId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.auth.uid == ownerUid
        && isImageOrPdf()
        && maxSize(10);
    }
  }
}
