rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users can access anything
    function isAuth() {
      return request.auth != null;
    }

    // Check if the requesting user owns the document
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && isOwner(userId);
      allow update: if isAuth() && isOwner(userId);
      allow delete: if false;
    }

    // Pets collection
    match /pets/{petId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Medical visits
    match /medicalVisits/{visitId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    // Lost pets
    match /lostPets/{lostPetId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Veterinarians — read by anyone authenticated, write only by support/admin
    match /veterinarians/{vetId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Stores
    match /stores/{storeId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Walkers
    match /walkers/{walkerId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Groomers
    match /groomers/{groomerId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Matches
    match /matches/{matchId} {
      allow read: if isAuth() && (
        resource.data.owner1Id == request.auth.uid ||
        resource.data.owner2Id == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.owner1Id == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }

    // Products
    match /products/{productId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.storeId == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuth();
      allow delete: if false;
    }
  }
}
