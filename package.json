{
  "name": "junglapp",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "mobile": "cd apps/mobile && npx expo start",
    "web": "cd apps/web && npm run dev"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "metro-runtime": "~0.81.0",
    "metro": "~0.81.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-reanimated": "3.16.1",
    "lightningcss": "^1.29.1"
  },
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=18.0.0"
  }
}
