{
  "name": "junglapp",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "mobile": "cd apps/mobile && npx expo start",
    "web": "cd apps/web && npm run dev"
  },
  "devDependencies": {
    "metro": "^0.83.1",
    "metro-runtime": "~0.81.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "lightningcss": "^1.29.1",
    "react-native-css-interop": {
      "lightningcss": "^1.29.1"
    }
  },
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=18.0.0"
  }
}
