+  // Android Studio's Gradle daemon doesn't inherit the shell PATH on Mac (Homebrew's
+  // node isn't found via a bare "node" lookup, unlike a plain terminal/CLI Gradle run).
+  // Try common Homebrew locations before falling back to a bare "node" (which still
+  // works wherever PATH resolution does, e.g. CI).
+  static private String resolveNodeBinary() {
+    def candidates = [
+      '/opt/homebrew/bin/node', // Homebrew on Apple Silicon
+      '/usr/local/bin/node',    // Homebrew on Intel Macs
+    ]
+    for (candidate in candidates) {
+      if (new File(candidate).exists()) return candidate
+    }
+    return 'node'
+  }
